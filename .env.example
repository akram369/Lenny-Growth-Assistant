# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env before running:
# cp .env.example .env

# --- Environment & App Settings ---
ENVIRONMENT=development
APP_NAME="The Lenny Growth Assistant"
APP_PORT=8001
DEBUG=true

# --- Database & Vector Persistence ---
# For local Docker Compose deployment:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
# For internal Docker network:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny_assistant
# For SQLite test fallback (if PostgreSQL is unavailable):
# DATABASE_URL=sqlite+aiosqlite:///./lenny_assistant.db

# --- Active LLM Provider Selection ---
# Options: "ollama" (Local LLM) or "cloud" (Anthropic / OpenAI)
# Evaluator Note: Ollama is default for the mandatory local demo.
DEFAULT_LLM_PROVIDER=ollama

# --- Local LLM Configuration (Ollama) ---
# Host endpoint for Ollama daemon:
OLLAMA_BASE_URL=http://localhost:11434
# Recommended local models: "llama3.2:3b", "llama3.1:8b", "mistral:7b", or "llama3.2:1b"
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# --- Cloud LLM Configuration (Anthropic & OpenAI) ---
# Active cloud driver: "anthropic" or "openai"
CLOUD_PROVIDER=anthropic

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration (Alternative cloud provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG & Vector Embeddings ---
# Local sentence-transformers model (384 dimensions, cosine similarity)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Embedding vector dimension (must match DB pgvector dimension)
EMBEDDING_DIMENSION=384
# Top-K chunks to retrieve per grounded query
RETRIEVAL_TOP_K=5
# Minimum cosine similarity threshold (below this, query is considered out-of-domain)
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# --- Transcripts Ingestion ---
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8001
PORT=3000
